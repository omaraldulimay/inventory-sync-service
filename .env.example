# Sync service (all values are optional, these are the defaults)
DATABASE_URL=sqlite+aiosqlite:///./sync.db
# DATABASE_URL=postgresql+asyncpg://sync:sync@localhost:5432/inventory_sync
ERP_BASE_URL=http://127.0.0.1:8000
SHOP_BASE_URL=http://127.0.0.1:8000
REQUEST_TIMEOUT_SECONDS=5
SHOP_REQUESTS_PER_SECOND=0.9
MAX_CONCURRENCY=4
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY_SECONDS=0.5
RETRY_MAX_DELAY_SECONDS=30
SCHEDULER_ENABLED=true
INCREMENTAL_INTERVAL_SECONDS=5
FULL_INTERVAL_SECONDS=60
ZERO_STOCK_GUARD_RATIO=0.5
ZERO_STOCK_GUARD_MIN_ITEMS=3
DEMO_MODE=true

# Mock systems
SHOP_RATE_LIMIT_REQUESTS=10
SHOP_RATE_LIMIT_WINDOW_SECONDS=10
SHOP_FAILURE_RATE=0.0
SHOP_LATENCY_MS=0
